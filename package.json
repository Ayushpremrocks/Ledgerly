{
  "private": true,
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "mvn -q -f backend/pom.xml -DskipTests package",
    "dev:backend": "neon-env run -- node scripts/run-backend.mjs",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8"
  },
  "name": "ledgerly"
}
